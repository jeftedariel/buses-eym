# ══════════════════════════════════════════════════════
# Variables de entorno para Coolify
# Configura estas en: Service → Environment Variables
# ══════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────
APP_NAME="Beldy"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                        # genera con: php artisan key:generate --show
APP_URL=https://boltbitcr.com

# ── Octane ────────────────────────────────────────────
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false               # Coolify/Traefik termina SSL, FrankenPHP corre en HTTP internamente

# ── Base de datos (Postgres en Coolify) ──────────────
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=postgres
DB_PASSWORD=

# ── Cache / Queue ─────────────────────────────────────
CACHE_DRIVER=redis              # o 'database' si no tenés Redis
QUEUE_CONNECTION=redis          # o 'database'
SESSION_DRIVER=redis            # o 'database'

# Redis (si usas uno en Coolify)
REDIS_HOST=tu-redis-service
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO (S3-compatible) ────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1    # MinIO acepta cualquier valor aquí
AWS_BUCKET=
AWS_URL=https://boltbitcr.com
AWS_ENDPOINT=https://boltbitcr.com
AWS_USE_PATH_STYLE_ENDPOINT=true  # REQUERIDO para MinIO

# ── Mail ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"
