# -----------------------------------------------------------------------------
# Environment values consumed by docker-compose.yml
# Copy this file to .env (or rename) before running `docker compose up`.
# These values are *injected into the container*; the runtime .env inside the
# image is generated from .env.example on first boot and overridden by these.
# -----------------------------------------------------------------------------

# --- Application ---
APP_NAME="Buses EYM"
APP_ENV=production
APP_DEBUG=false
# Run once: `docker compose run --rm app php artisan key:generate --show`
# Then paste the value here.
APP_KEY=
APP_URL=http://localhost:7070
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# --- Host ports ---
APP_HOST_PORT=7070
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- PostgreSQL ---
POSTGRES_DB=buses_eym
POSTGRES_USER=buses_eym
POSTGRES_PASSWORD=change-me-postgres

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=uploads

AWS_DEFAULT_REGION=us-east-1
# Public URL Laravel emits in generated asset links. When Caddy fronts MinIO,
# point this at the public host instead (e.g. https://files.example.com/uploads).
AWS_URL=http://localhost:9000/uploads

# --- Mail ---
MAIL_MAILER=log

# --- Optional: seed the DB on first boot ---
RUN_SEEDERS=false
